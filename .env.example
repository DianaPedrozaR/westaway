# Local dev: SQLite file, no setup needed.
# On Railway: set DATABASE_URL to the Postgres plugin's connection string and
# change prisma/schema.prisma's datasource provider from "sqlite" to "postgresql"
# before running `prisma migrate deploy`.
DATABASE_URL="file:./dev.db"

# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Shared passcode gating access to both apps once deployed.
ACCESS_PASSCODE="westaway2026"
