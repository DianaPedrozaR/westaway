# Required
ANTHROPIC_API_KEY=

# Calendly links for the two reps. Real URLs don't exist yet — placeholders
# until Westaway hands them over.
CALENDLY_KYLE_URL=https://calendly.com/REPLACE_ME/kyle
CALENDLY_STEPHANIE_URL=https://calendly.com/REPLACE_ME/stephanie

# Optional. claude-sonnet-5 is materially cheaper/faster for this task if the
# extra Opus-tier reasoning headroom isn't needed in practice.
CLAUDE_MODEL=claude-opus-5

# Local dev only — uvicorn reads $PORT on Railway; this is just for `--reload` runs.
PORT=8000
